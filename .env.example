# ─────────────────────────────────────────────────────────────
# SAHARA — environment template. Copy to `.env` and fill in.
# NEVER commit `.env`. Placeholders only in this file.
# ─────────────────────────────────────────────────────────────

# PostgreSQL. Default matches `npm run db:local` (embedded Postgres on 5433).
DATABASE_URL="postgresql://sahara:sahara_local_dev@localhost:5433/sahara?schema=public"

# Public base URL of the dashboard (used in notification links).
APP_BASE_URL="http://localhost:3000"

# Enables the demo seed script and a "DEMO DATA" banner. Never enable in production.
DEMO_MODE="false"

# ── Telegram ────────────────────────────────────────────────
# From @BotFather. Server-side only.
TELEGRAM_BOT_TOKEN="replace-with-botfather-token"
# Random string (A-Z a-z 0-9 _ -, 1–256 chars). Telegram sends it back in the
# X-Telegram-Bot-Api-Secret-Token header; the webhook rejects mismatches.
TELEGRAM_WEBHOOK_SECRET="replace-with-long-random-string"
TELEGRAM_API_BASE="https://api.telegram.org"
# Public bot username without the @ (only used to show t.me links on the dashboard).
TELEGRAM_BOT_USERNAME="your_sahara_bot"

# ── LLM classifier ──────────────────────────────────────────
# gemini     → Google Gemini (requires GEMINI_API_KEY)
# heuristic  → offline keyword classifier for local dev without a key (low confidence, flagged for review)
# none       → no classifier; every non-emergency request is saved as "unclassified" for review
LLM_PROVIDER="gemini"
GEMINI_API_KEY="replace-with-gemini-api-key"
GEMINI_MODEL="gemini-flash-latest"
GEMINI_API_BASE="https://generativelanguage.googleapis.com"
LLM_TIMEOUT_MS="8000"
# Below this confidence, a classified request is flagged NEEDS_REVIEW.
LLM_MIN_CONFIDENCE="0.6"

# ── Emergency escalation policy ─────────────────────────────
# Seconds without acknowledgement before escalating to the next responder level.
ESCALATION_ACK_TIMEOUT_SECONDS="120"
# When the last responder level is reached, keep re-alerting everyone each interval.
ESCALATION_REPEAT_LAST_LEVEL="true"
# Total escalation rounds before the worker stops re-alerting (alert stays unacknowledged on the dashboard).
ESCALATION_MAX_ROUNDS="5"

# ── Notification delivery ───────────────────────────────────
# telegram (default) | console (DEV ONLY: prints notifications to the server log instead of sending; refused in production)
NOTIFY_CHANNEL="telegram"
NOTIFY_MAX_ATTEMPTS="5"
NOTIFY_EMERGENCY_MAX_ATTEMPTS="10"
WORKER_INTERVAL_MS="5000"

# ── Rate limits ─────────────────────────────────────────────
RATE_LIMIT_MESSAGES_PER_MINUTE="20"
RATE_LIMIT_LINK_ATTEMPTS_PER_15_MIN="5"
RATE_LIMIT_LOGIN_ATTEMPTS_PER_15_MIN="10"

# ── Sessions / pairing ──────────────────────────────────────
SESSION_TTL_HOURS="168"
PAIRING_CODE_TTL_MINUTES="15"
