{
  "name": "sahara",
  "version": "0.1.0",
  "private": true,
  "description": "SAHARA MVP — Telegram intake, LLM classification, child dashboard and SOS alerts",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "node scripts/prepare-sqlite.mjs && prisma migrate deploy && next start",
    "worker": "tsx scripts/worker.ts",
    "bot:poll": "tsx scripts/poll-telegram.ts",
    "bot:set-webhook": "tsx scripts/set-webhook.ts",
    "bot:simulate": "tsx scripts/simulate-message.ts",
    "dev:all": "concurrently -n web,worker,bot -c blue,magenta,green \"npm:dev\" \"npm:worker\" \"npm:bot:poll\"",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "^15.5.27",
    "prisma": "^6.19.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
